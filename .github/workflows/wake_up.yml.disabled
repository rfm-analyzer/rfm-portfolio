name: Wake Up App

#on:
#  schedule:
    - cron: '*/10 * * * *'
  workflow_dispatch:

jobs:
  ping_app:
    runs-on: ubuntu-latest
    steps:
      - name: Wake up Streamlit app (direct URL, bypass Cloudflare)
        run: |
          # Пингуем напрямую Streamlit, минуя Cloudflare
          curl -s -L \
            -H "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36" \
            -H "Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8" \
            -o /dev/null \
            -w "HTTP: %{http_code}, Time: %{time_total}s, URL: %{url_effective}\n" \
            https://rfm-portfolio-d8n9iseq4eujggglvwd5my.streamlit.app
